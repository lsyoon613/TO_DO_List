<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="오늘 할 일" Width="410" Height="740" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI, Malgun Gothic" FontSize="14" Background="{DynamicResource Panel}" Foreground="{DynamicResource Text}">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#202020"/><SolidColorBrush x:Key="Card" Color="#2C2C2C"/><SolidColorBrush x:Key="Text" Color="#F5F5F5"/><SolidColorBrush x:Key="Muted" Color="#B5B5B5"/><SolidColorBrush x:Key="Line" Color="#454545"/><SolidColorBrush x:Key="Accent" Color="#9ACBFF"/>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="MinHeight" Value="32"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
   <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"/>
   <ToggleButton x:Name="DropToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
   <ContentPresenter x:Name="SelectedText" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="9,5,28,5" VerticalAlignment="Center"/>
   <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="{DynamicResource Card}" Foreground="{DynamicResource Text}" BorderThickness="0" Padding="6,3" Margin="3,2,28,2" VerticalContentAlignment="Center"/>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="3"><ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer></Border></Popup>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter TargetName="SelectedText" Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DatePicker"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/></Style>
  <Style TargetType="DatePickerTextBox"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePickerTextBox"><Border Background="{TemplateBinding Background}" Padding="5"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="CaretBrush" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="10,9"/></Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="22">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0"><DockPanel><Button x:Name="HideButton" DockPanel.Dock="Right" Content="✕" ToolTip="닫기 · 트레이에서 계속 실행" AutomationProperties.Name="패널 닫기"/><TextBlock Text="오늘 할 일" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="Today" Foreground="{DynamicResource Muted}" Margin="0,8,0,20"/></StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,12"><ComboBox x:Name="FolderFilter" AutomationProperties.Name="과목 폴더" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ActiveTab" Content="할 일" Margin="0,0,4,0"/><Button x:Name="DoneTab" Grid.Column="1" Content="완료" Margin="4,0,0,0"/></Grid></StackPanel>
  <Border x:Name="Composer" Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="8" Padding="12" Margin="0,0,0,18"><StackPanel><TextBlock x:Name="EditorLabel" Text="새 할 일" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="TaskInput" MaxLength="500" AutomationProperties.Name="할 일 내용" ToolTip="할 일을 입력하고 Enter를 누르세요"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="과목 / 폴더" FontSize="12" Margin="0,0,0,5"/><ComboBox x:Name="SubjectInput" IsEditable="True" AutomationProperties.Name="과목 입력" ToolTip="새 과목을 입력하거나 기존 과목을 선택하세요"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="진행 상태" FontSize="12" Margin="0,0,0,5"/><ComboBox x:Name="ProgressInput" AutomationProperties.Name="새 할 일 진행 상태"/></StackPanel></Grid><TextBlock Text="마감일 · Due date (선택)" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="DueInput" SelectedDateFormat="Short" VerticalContentAlignment="Center" AutomationProperties.Name="마감일"/><Button x:Name="ClearDate" Grid.Column="1" Content="×" ToolTip="마감일 지우기" Padding="8,4"/><Button x:Name="AddButton" Grid.Column="2" Content="추가" Background="{DynamicResource Accent}" Foreground="#17202B" Margin="5,0,0,0"/></Grid><Button x:Name="CancelEdit" Content="수정 취소" Visibility="Collapsed" Margin="0,8,0,0"/></StackPanel></Border>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskList"/></ScrollViewer>
  <TextBlock x:Name="Status" Grid.Row="4" Text="이 PC에 자동 저장됩니다" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,16,0,0" TextWrapping="Wrap"/>
 </Grid></Border>
</Window>
